# PostgreSQL connection string.
# For local Docker (docker-compose up): postgresql://subscription_tracker:subscription_tracker@localhost:5432/subscription_tracker?schema=public
# For a hosted provider (Neon, Supabase, Railway, etc.), paste the connection string they give you.
DATABASE_URL="postgresql://subscription_tracker:subscription_tracker@localhost:5432/subscription_tracker?schema=public"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: GitHub OAuth. Leave both blank to run with credentials (email/password) login only.
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Optional: password-reset emails, sent via Gmail SMTP. Leave both blank to
# disable — the reset link is logged to the server console instead, which
# is fine for local development.
# GMAIL_USER is the full Gmail address to send from. GMAIL_APP_PASSWORD is
# a 16-character App Password (NOT your regular Gmail password) — generate
# one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be enabled on the account first).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="Subscription Tracker"
