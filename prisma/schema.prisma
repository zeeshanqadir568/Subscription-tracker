generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  // Null when the account was created via GitHub OAuth only (no password set).
  passwordHash        String?
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of the token emailed to the user — the raw token never
  // touches the database, so a DB leak alone can't be used to reset a
  // password.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id              String       @id @default(cuid())
  name            String
  cost            Decimal      @db.Decimal(10, 2)
  billingCycle    BillingCycle
  nextRenewalDate DateTime
  // Validated against a shared allow-list in Zod rather than a DB enum,
  // so adding a category later doesn't require a migration.
  category        String
  notes           String?
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([userId, nextRenewalDate])
}
